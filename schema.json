{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TelemetryPacketContract",
  "description": "Контракт данных пакета телеметрии куста скважин (Вариант Б)",
  "type": "object",
  "required": ["pad_id", "well_id", "p_res_mpa", "p_bhp_mpa", "mode", "is_online", "sensors"],
  "properties": {
    "pad_id": { "type": "string", "minLength": 1 },
    "well_id": { "type": "string", "minLength": 1 },
    "p_res_mpa": { "type": "number", "minimum": 5.0, "maximum": 60.0 },
    "p_bhp_mpa": { "type": "number", "minimum": 1.0, "maximum": 60.0 },
    "mode": {
      "type": "string",
      "enum": ["FLOWING", "PUMPING", "SHUT_IN"]
    },
    "is_online": { "type": "boolean" },
    "sensors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["code", "value", "unit"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "unit": {
            "type": "string",
            "enum": ["MPa", "C", "m3/d"]
          }
        }
      }
    }
  }
}
